# ============ 服务器配置 ============
PORT=3000
NODE_ENV=production
# 前端域名（用于CORS白名单）
FRONTEND_URL=https://universal-equality.surge.sh

# ============ 支付宝配置 ============
# 支付宝开放平台 https://open.alipay.com
# 需要企业营业执照，创建"网页/移动应用"并签约"转账到支付宝账户"产品
ALIPAY_APP_ID=your_alipay_app_id
# 应用私钥（PKCS8格式，在开放平台生成）
ALIPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_Private_Key_Here\n-----END PRIVATE KEY-----"
# 支付宝公钥（从开放平台获取）
ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYour_Public_Key_Here\n-----END PUBLIC KEY-----"
# 支付宝网关（正式环境）
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# 签名类型
ALIPAY_SIGN_TYPE=RSA2

# ============ 微信支付配置 ============
# 微信支付商户平台 https://pay.weixin.qq.com
# 需要企业营业执照，申请商户号，开通"企业付款到零钱"或"商家转账到零钱"产品
WECHAT_MCH_ID=your_wechat_mch_id
WECHAT_APP_ID=your_wechat_app_id
# APIv3密钥（在商户平台设置）
WECHAT_API_V3_KEY=your_wechat_api_v3_key
# 商户API证书序列号
WECHAT_MCH_SERIAL_NO=your_mch_serial_no
# 商户API私钥（apiclient_key.pem内容）
WECHAT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_Wechat_Private_Key_Here\n-----END PRIVATE KEY-----"
# 微信支付平台证书（用于验证回调，需通过API下载）
WECHAT_PLATFORM_CERT="-----BEGIN CERTIFICATE-----\nYour_Platform_Cert_Here\n-----END CERTIFICATE-----"

# ============ 银行转账配置（以银联/网商银行为例） ============
# 银行API需要与具体银行签订合作协议，此处以网商银行/银联为例
BANK_API_URL=https://api.mybank.cn
BANK_PARTNER_ID=your_bank_partner_id
BANK_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_Bank_Private_Key_Here\n-----END PRIVATE KEY-----"
BANK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYour_Bank_Public_Key_Here\n-----END PUBLIC KEY-----"

# ============ 全球金融账户配置（以Stripe为例） ============
# Stripe https://stripe.com 支持全球多国支付
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# ============ 安全配置 ============
# JWT密钥（用于API鉴权）
JWT_SECRET=your_secure_jwt_secret_key_change_this
# API访问密钥（前端调用时需携带）
API_KEY=your_api_key_for_frontend
